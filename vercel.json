{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/studio/cron/scrape?scope=mine",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/studio/cron/scrape?scope=competitors",
      "schedule": "30 6 * * 1,4"
    }
  ]
}
